# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code: keep shared settings, ignore machine-local + transient
.claude/settings.local.json
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/ide/
.claude/*.log

# Secrets / env
.env
.env.*
*.pem
*.key

# Logs and temp
*.log
tmp/
temp/

# Ideas/ is a SEPARATE PROJECT with its own git repository (Glacier Line).
# It lives inside this folder only for convenience. Ignoring it here keeps the
# two histories completely independent and stops `git add .` from staging it as
# a stray gitlink. Do not commit it to the Aroma Wheel repo — commit inside
# Ideas/ instead, where it has its own history.
Ideas/
